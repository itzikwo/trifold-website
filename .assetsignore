# Paths wrangler must not upload as public static assets.
#
# assets.directory in wrangler.jsonc is "." (the repo root), so without this
# file wrangler walks the entire checkout — including .git, which would serve
# the full repository and its history from https://trifoldtechnologies.com/.git/
#
# gitignore syntax. Keep this list narrow: anything not matched here is public.
# In particular content.json (fetched by admin.html) and
# ai-strategy-playbook/templates/* (linked downloads) must stay deployed.

# Version control
**/.git
**/.gitignore
**/.github

# Wrangler scratch output
**/.wrangler

# Repo docs and local tooling — not part of the site
CLAUDE.md
README.md
**/.DS_Store

# Admin dashboard. A client-side draft editor with no server component, so it
# has no business being public — run it locally from the repo instead:
#   python3 -m http.server 8000   then open http://localhost:8000/admin.html
# (needs a local server, not file://, because it fetches content.json).
admin.html
admin/

# This file
.assetsignore

# Worker source (deployed as code, via main in wrangler.jsonc) and local
# tooling. Neither belongs in the public asset tree.
src/
tools/
test/
package.json
package-lock.json
vitest.config.js
node_modules/
